# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local Mongo:        mongodb://127.0.0.1:27017/pte_master
# Atlas example:      mongodb+srv://user:pass@cluster.mongodb.net/pte_master
MONGO_URI=mongodb://127.0.0.1:27017/pte_master

# --- Security ---
# Use a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ghjhgvjbhjkjhuigbkl
JWT_EXPIRES_IN=7d

# --- Admin seeder (npm run seed:admin) ---
# When ADMIN_PASSWORD is omitted a strong random password is generated and
# printed once at the end of the script. It is never stored in source code.
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=<choose a password with at least 8 characters>

# --- Client ---
# Comma-separated list of allowed origins for CORS.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# --- AI scoring (optional) ---
# Keep this key on the backend only. The frontend calls /api/ai/score.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, for example an Azure or local gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Uploads ---
MAX_UPLOAD_MB=15
